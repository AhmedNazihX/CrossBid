#!/usr/bin/env bash
# Crossbid pre-commit hook (story S0.1.3).
#
# Enable once per clone:   git config core.hooksPath .githooks
# Skip deliberately:       git commit --no-verify
#
# Deliberately a plain git hook rather than the `pre-commit` framework: it adds no
# dependency, and every tool it calls is already installed by `make install`.

set -uo pipefail
failed=0

step() {
  local label=$1; shift
  if ! out=$("$@" 2>&1); then
    printf '  FAIL  %s\n' "$label"
    printf '%s\n' "$out" | sed 's/^/        /' | head -30
    failed=1
  else
    printf '  ok    %s\n' "$label"
  fi
}

staged() { git diff --cached --name-only --diff-filter=ACM; }

echo "pre-commit:"

# Never let a secret through, whatever else happens.
if staged | grep -qE '(^|/)\.env$'; then
  echo "  FAIL  a .env file is staged — unstage it"
  exit 1
fi
if staged -z | xargs -0 -r grep -lIE 'sk-or-v1-[A-Za-z0-9]{20}|sk-[A-Za-z0-9]{40}' 2>/dev/null | grep -q .; then
  echo "  FAIL  a staged file contains something shaped like an API key"
  exit 1
fi

if staged | grep -qE '^backend/.*\.py$'; then
  step "ruff check"   bash -c 'cd backend && uv run ruff check .'
  step "ruff format"  bash -c 'cd backend && uv run ruff format --check .'
fi

if staged | grep -qE '^frontend/.*\.(ts|tsx|js|jsx|css|json|md)$'; then
  if [ -x frontend/node_modules/.bin/prettier ]; then
    step "prettier" bash -c 'cd frontend && ./node_modules/.bin/prettier --check .'
  else
    echo "  skip  prettier (not installed in frontend/)"
  fi
fi

# Any dependency change must be reflected in the generated manifest.
if staged | grep -qE '^(backend/(pyproject\.toml|uv\.lock)|frontend/(package\.json|package-lock\.json))$'; then
  step "deps-check" python3 scripts/gen_dependencies.py --check
fi

if [ "$failed" -ne 0 ]; then
  echo
  echo "Commit aborted. Fix the above, or re-run with --no-verify to bypass."
  exit 1
fi
