# Frontend-only ignores. The repository root .gitignore already covers
# node_modules/, .next/, .env* and .DS_Store — do not repeat them here.

# build output
/out/
/build/

# test output
/coverage/
# playwright (npm run test:e2e): reports, traces, screenshots
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# typescript
*.tsbuildinfo
next-env.d.ts

# next.js / vercel
.vercel

# logs
npm-debug.log*
.pnpm-debug.log*

# certs
*.pem

# NOTE: lib/api.ts is generated by `npm run gen:api` but IS committed — CI
# regenerates it and fails on drift (S0.1.4 / S0.4.2). Never edit it by hand.
