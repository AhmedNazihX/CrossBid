# Copy to the repository root as `.env`:  cp infra/.env.example .env
# Never commit .env — the root .gitignore excludes it.

# ---- LLM access (required) -------------------------------------------------
# OpenRouter is the single provider. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-replace-me

# ---- Encryption (required) ------------------------------------------------
# Fernet key encrypting users' own provider keys at rest (BYOK, S5.4-S5.6).
# Generate: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Startup only checks this is present and non-blank, so the placeholder below would pass and
# then fail at the first encrypt. Replace it before running anything that stores a key.
APP_ENCRYPTION_KEY=replace-me-with-a-real-fernet-key

# ---- Database -------------------------------------------------------------
# REQUIRED for host runs (`make dev-api`). Inside Compose the api service supplies its own
# default pointing at the `db` service, so DATABASE_URL may be left blank there — but the
# POSTGRES_* variables below are read only by Compose, never by the backend, so nothing
# derives a DSN from them on the host.
#
# For the hosted Supabase EU project, paste the DIRECT connection string locally and the
# SESSION POOLER string in deployment. The TRANSACTION pooler is refused at startup: it has
# no prepared statements, so the LangGraph checkpointer fails.
DATABASE_URL=postgresql://crossbid:crossbid@localhost:5432/crossbid
# DATABASE_URL=postgresql://postgres:...@db.<ref>.supabase.co:5432/postgres
POSTGRES_USER=crossbid
POSTGRES_PASSWORD=crossbid
POSTGRES_DB=crossbid
POSTGRES_PORT=5432

# ---- Supabase Auth + Storage ---------------------------------------------
# From the project's API settings. The service key is server-side only and must never
# reach the browser; only the anon key is exposed to the web app.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# ---- Auth mode ------------------------------------------------------------
# `dev` lets requests pass an X-Dev-Company header instead of a token, so Increments 1-3
# can run before magic-link sign-in lands (S0.3.1). Refused at startup when ENV=production.
AUTH_MODE=dev
# One of: development | test | production. CI sets `test`. A value outside the three is
# refused at startup rather than quietly treated as "not production".
ENV=development
DEVELOPER_EMAILS=

# ---- Observability (optional) --------------------------------------------
# Without a key the app runs normally, traces nothing, and says nothing about it.
# Do NOT set LANGSMITH_TRACING / LANGCHAIN_TRACING_V2 by hand: the app owns those four
# flags and overwrites them at startup from whether a key is present.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=crossbid

# ---- Model-slug startup probe (optional) ---------------------------------
# `true` sends one token to every configured chat slug at startup and fails fast on any
# that does not answer. Off by default: it costs money and needs a real key. Worth enabling
# once per environment, because presence in OpenRouter's /models does not mean a model is
# usable on an account (ADR-0005).
VERIFY_MODEL_SLUGS=false

# ---- Ports and origins ---------------------------------------------------
API_PORT=8000
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
